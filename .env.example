# Copie este arquivo para .env.local (desenvolvimento) e configure também
# essas mesmas variáveis nas configurações do projeto na Vercel.

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_aqui_a_anon_key
SUPABASE_SERVICE_ROLE_KEY=coloque_aqui_a_service_role_key

# resend.com — crie uma conta grátis e gere uma API key
RESEND_API_KEY=
EMAIL_REMETENTE="FixIn Reformas <orcamentos@seudominio.com.br>"

# Chave da API da Anthropic (console.anthropic.com) — usada só para a geração
# automática de itens de orçamento por IA. Deixe em branco se não for usar isso.
ANTHROPIC_API_KEY=

# E-mail (escolha UM): caixa da Hostinger (recomendado) ou Resend
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=orcamentos@seudominio.com.br
# SMTP_PASS=senha-da-caixa-de-email
# EMAIL_REMETENTE=FixIn Reformas <orcamentos@seudominio.com.br>   (só o nome é usado com SMTP)
# EMAIL_COPIA=voce@seudominio.com.br   (opcional: recebe cópia oculta de todo orçamento enviado)
# RESEND_API_KEY=

# Modelo da IA do orçamento (opcional). Padrão: claude-sonnet-5-5. Para voltar ao anterior: claude-sonnet-5
# IA_MODELO=claude-sonnet-5-5
